# Server Environment & Port
NODE_ENV=production
PORT=5001

# Super Admin Email
ADMIN_EMAIL=jatindudhani07@gmail.com
MAIN_ADMIN_EMAIL=jatindudhani07@gmail.com

# Optional custom secret key for admin authentication
ADMIN_SECRET=generate_a_random_32_char_secret_here

# MongoDB Atlas (Connection string from https://cloud.mongodb.com)
# If omitted, server falls back to in-memory list storage
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/bulk-email?retryWrites=true&w=majority

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=bulk-email-6498b
# Optional: Service account JSON path or individual key variables
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bulk-email-6498b.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional Server Default SMTP (Only accessible by the verified admin)
# Standard users will provide their own Gmail SMTP credentials in the app UI
EMAIL_USER=
EMAIL_PASS=

# Allowed CORS Origins (comma separated list of frontend deployment URLs)
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.onrender.com,http://localhost:3000,http://localhost:3001
